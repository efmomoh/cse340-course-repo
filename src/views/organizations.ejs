<!-- A page to list the partner organizations. -->
<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <p>Here are a few of our partner organizations:</p>
        <ul class="organization-list">

            <% organizations.forEach(organization=> { %>
                <li><img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo">
                    <a href="/organization/<%= organization.organization_id %>">
                        <strong>
                            <%= organization.name %>
                        </strong>
                    </a>: <%= organization.contact_email %>
                </li>
                <% }); %>
        </ul>

        <!-- Add a link to create a new organization if the user is an admin -->
        <% if (user && user.role_name === 'admin') { %>
            <p><a href="/new-organization">Add a new organization</a></p>
        <% } %>
    </main>

    <%- include('partials/footer') %>