<!-- Dashboard page for logged-in users -->
<%- include('partials/header') %>

    <main class="dashboard">

        <div class="dashboard-card">

            <h1>
                <%= title %>
            </h1>

            <h2>
                Welcome, <%= name.charAt(0).toUpperCase() + name.slice(1) %>!
            </h2>

            <p class="dashboard-message">
                You've logged in successfully as a/an
                <%= role.charAt(0).toUpperCase() + role.slice(1) %>.
            </p>

            <div class="dashboard-details">

                <p>
                    <strong>Name:</strong>
                    <span>
                        <%= name %>
                    </span>
                </p>

                <p>
                    <strong>Username:</strong>
                    <span>
                        <%= email %>
                    </span>
                </p>

                <p>
                    <strong>Role:</strong>
                    <span class="dashboard-role">
                        <%= role %>
                    </span>
                </p>

            </div>

            <!--Adds a horizontal rule -->
            <hr>

            <!-- Projects the current user has volunteered for -->
            <section class="volunteer-projects">
                <h2>My Volunteer Projects</h2>

                <% if (volunteerProjects && volunteerProjects.length> 0) { %>

                    <p>
                        You have signed up for <%= volunteerProjects.length %>
                            project(s).
                            <a href="/projects">Browse More Service Projects</a>
                    </p>

                    <ul class="project-list">
                        <% volunteerProjects.forEach(project=> { %>
                            <li>
                                <h3>
                                    <a href="/project/<%= project.project_id %>">
                                        <%= project.title %>
                                    </a>
                                </h3>

                                <p>
                                    <strong>Organization:</strong>
                                    <%= project.organization_name %>
                                </p>

                                <p>
                                    <strong>Date:</strong>
                                    <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric' ,
                                        month: 'long' , day: 'numeric' }) %>
                                </p>

                                <p>
                                    <strong>Location:</strong>
                                    <%= project.location %>
                                </p>

                                <form action="/project/<%= project.project_id %>/withdraw" method="POST">
                                    <button type="submit">
                                        Withdraw from Project
                                    </button>
                                </form>
                            </li>
                            <% }); %>
                    </ul>

                    <% } else { %>

                        <p>
                            You haven't signed up to volunteer for any projects yet.
                            <a href="/projects">Browse service projects</a> to get started.
                        </p>

                        <% } %>
            </section>

            <!-- Admin-only action -->
            <% if (role==='admin' ) { %>
                <div class="dashboard-actions">
                    <a class="dashboard-button" href="/users">
                        View Registered Users
                    </a>
                </div>
                <% } %>

        </div>

    </main>

    <%- include('partials/footer') %>