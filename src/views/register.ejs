<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <form action="/register" method="post">

        <div class="form-group">
            <label for="name">Name</label>
            <input type="text" name="name" id="name" required minlength="3" title="Name must be at least 3 characters long">
        </div>

        <div class="form-group">
            <label for="email">Email (Username)</label>
            <input type="email" name="email" id="email" required maxlength="50" title="Please enter a valid email address">
        </div>
        <div class="form-group">
            <label for="password">Password</label>
            <input type="password" name="password" id="password" required minlength="6" maxlength="50" title="Password must be at least 6 characters long">
        </div>

    <button type="submit" title="Register">Register</button>
    </form>
</main>
<%- include('partials/footer') %>