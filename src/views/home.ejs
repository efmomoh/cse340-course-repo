<!-- The main home page for the site  -->
<%- include("partials/header") %>
    <main>
        <h1>
            <%= title %>
        </h1>
        <h2>Welcome to the CSE 340 Service Network!</h2>
        <p>Our mission is to promote service across the world
            by connecting volunteers with service opportunities in their community.</p>
        <img class="main-logo" src="images/cse340-service-network.png" alt="CSE 340 Service Network Logo">

        <% if (isLoggedIn) { %>
            <p>Welcome back, <%= name %>! You are logged in.</p>
            <p><a href="/dashboard">My Dashboard</a></p>
            <% } else { %>
                <p><a href="/login">Login</a> or <a href="/register">Register</a> to access your dashboard.</p>
                <% } %>


    </main>
    <%- include("partials/footer") %>