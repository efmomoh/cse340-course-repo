<!-- A page to list all the service projects that are currently available. -->
<%- include("partials/header") %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <!-- <h2>Upcoming Service Projects</h2> -->

        <ul class="project-list">
            <% projects.forEach(project=> { %>

                <li><strong>
                        <%= new Date(project.project_date).toLocaleDateString('en-US', { year: 'numeric' , month: 'long'
                            , day: 'numeric' }) %>:
                    </strong>
                    <a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a>:
                    <strong>
                        (<a href="/organization/<%= project.organization_id %>">
                            <%= project.name %>
                        </a>)
                    </strong>
                </li>
                <% }); %>
        </ul>
    </main>

    <%- include("partials/footer") %>