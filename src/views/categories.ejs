<!-- All categories page -->
<%- include("partials/header") %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>Welcome to the categories page!</h2>

        <p>Here are the different categories of service opportunities available:</p>

        <ul class="category-list">
            <% categories.forEach(category=> { %>
                <li>
                    <a href="/category/<%= category.category_id %>">
                        <%= category.category_name %>
                    </a>
                </li>
                <% }); %>
        </ul>

        <!-- Add a link to create a new category if the user is an admin -->
        <% if (user && user.role_name==='admin' ) { %>
            <p> <a href="/new-category">Add a New Category</a> </p>
            <% } %>
    </main>

    <%- include("partials/footer") %>